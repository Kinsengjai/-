/* =========================================================
   跑步熱力圖(最近26週,固定不受圖表範圍影響)
   ========================================================= */
function renderHeatmap(){
  const wrap = document.getElementById('heatmapWrap');
  if(RUNS.length===0){
    wrap.innerHTML = '<div class="empty-state">還沒有資料。</div>';
    return;
  }
  const dayTotals = {};
  RUNS.forEach(r=>{ dayTotals[r.date] = (dayTotals[r.date]||0) + r.distanceKm; });

  const today = new Date(); today.setHours(0,0,0,0);
  const todayKey = localISODate(today);
  const endDow = (today.getDay()+6)%7; // 週一=0
  const end = new Date(today); end.setDate(end.getDate() + (6-endDow)); // 延伸到這週的週日
  const totalDays = 26*7;
  const start = new Date(end); start.setDate(start.getDate() - totalDays + 1);
  const maxKm = Math.max(...Object.values(dayTotals), 0.001);
  const CELL_STEP = 15; // 12px 方格 + 3px 間距

  // 月份標籤:每當這一週的星期一落在新的月份,就在那一欄上方標註月份
  let monthHtml = '';
  let lastMonth = null;
  for(let w=0; w<26; w++){
    const colStart = new Date(start); colStart.setDate(colStart.getDate() + w*7);
    const m = colStart.getMonth();
    if(m !== lastMonth){
      monthHtml += `<span style="left:${w*CELL_STEP}px;">${m+1}月</span>`;
      lastMonth = m;
    }
  }

  let gridHtml = '<div class="heatmap">';
  for(let w=0; w<26; w++){
    gridHtml += '<div class="heatmap-col">';
    for(let d=0; d<7; d++){
      const day = new Date(start); day.setDate(day.getDate() + w*7 + d);
      const key = localISODate(day);
      const km = dayTotals[key] || 0;
      let level = 0;
      if(km>0){
        const ratio = km/maxKm;
        level = ratio>0.66 ? 4 : ratio>0.4 ? 3 : ratio>0.15 ? 2 : 1;
      }
      const isToday = key===todayKey;
      const title = key + (km>0 ? `・${km.toFixed(1)}km` : '') + (isToday ? '(今天)' : '');
      gridHtml += `<div class="heatmap-cell" data-level="${level}" ${isToday?'data-today="1"':''} title="${title}"></div>`;
    }
    gridHtml += '</div>';
  }
  gridHtml += '</div>';

  wrap.innerHTML = `
    <div class="heatmap-month-row">${monthHtml}</div>
    <div class="heatmap-flex">
      <div class="heatmap-weekdays"><div>一</div><div></div><div>三</div><div></div><div>五</div><div></div><div>日</div></div>
      ${gridHtml}
    </div>
    <div class="heatmap-legend">
      少
      <div class="heatmap-cell" data-level="0"></div>
      <div class="heatmap-cell" data-level="1"></div>
      <div class="heatmap-cell" data-level="2"></div>
      <div class="heatmap-cell" data-level="3"></div>
      <div class="heatmap-cell" data-level="4"></div>
      多
      <span class="heatmap-today-note"><div class="heatmap-cell" data-level="0" data-today="1"></div>今天</span>
    </div>
  `;
}

/* =========================================================
   共用格式化 / 換算函式
   ========================================================= */
function uid(){ return 'r'+Date.now()+Math.random().toString(16).slice(2,8); }

// 取得「本地時區」的日期字串(YYYY-MM-DD)。
// 注意:不能用 d.toISOString().slice(0,10) —— toISOString 會先轉成 UTC 時間再取日期,
// 對 UTC+8(台灣)來說,只要本地時間在凌晨 0~8 點之間,轉成 UTC 就會跨到前一天,
// 導致日期算錯一天(例如清晨跑步的紀錄被記成前一天)。這裡改用本地時間的年/月/日組字串。
function localISODate(d){
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

function formatDate(iso){
  const d = new Date(iso);
  if(isNaN(d)) return iso;
  return `${d.getFullYear()}/${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')}`;
}
function formatDuration(sec){
  sec = Math.round(sec);
  const h = Math.floor(sec/3600);
  const m = Math.floor((sec%3600)/60);
  const s = sec%60;
  if(h>0) return `${h}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  return `${m}:${String(s).padStart(2,'0')}`;
}
function formatPace(secPerKm){
  if(!isFinite(secPerKm) || secPerKm<=0) return '—';
  const total = Math.round(secPerKm); // 先四捨五入總秒數,再拆分鐘/秒,避免秒被進位成60
  const m = Math.floor(total/60);
  const s = total%60;
  return `${m}:${String(s).padStart(2,'0')} /km`;
}
function parseDurationToSeconds(hStr,mStr,sStr){
  const h = parseFloat(hStr)||0, m = parseFloat(mStr)||0, s = parseFloat(sStr)||0;
  return h*3600 + m*60 + s;
}
// 解析 Garmin 常見的時間字串,例如 "0:45:23" "45:23" "45:23.4"
function parseGarminTime(str){
  if(!str) return null;
  str = str.trim();
  const parts = str.split(':').map(p=>parseFloat(p));
  if(parts.some(isNaN)) return null;
  if(parts.length===3) return parts[0]*3600+parts[1]*60+parts[2];
  if(parts.length===2) return parts[0]*60+parts[1];
  if(parts.length===1) return parts[0];
  return null;
}
function parseGarminDistance(str, unit){
  if(str===undefined||str===null||str==='') return null;
  let v = parseFloat(String(str).replace(/,/g,''));
  if(isNaN(v)) return null;
  if(unit==='mile') v = v*1.60934;
  return v;
}
function parseGarminDate(str){
  if(!str) return null;
  // Garmin 常見格式 "2024-06-01 07:32:10" 或 "2024-06-01"
  const d = new Date(str.replace(' ', 'T'));
  if(isNaN(d)) return null;
  return localISODate(d);
}
function parseNum(str){
  if(str===undefined||str===null||str==='') return null;
  const v = parseFloat(String(str).replace(/,/g,''));
  return isNaN(v) ? null : v;
}
// 爬升/下降/步幅在 Garmin 匯出檔裡跟著帳號的公制/英制設定走,跟距離單位一致,
// 所以沿用同一個 unit 選項來換算(英制時是英尺,換算成公尺)
function parseGarminSmallMetric(str, unit){
  const v = parseNum(str);
  if(v===null) return null;
  return unit==='mile' ? v*0.3048 : v;
}
// 配速字串(例如 "5:12")換算成「秒/公里」;英制單位時是「秒/英里」需要換算
function parseGarminPaceToSecPerKm(str, unit){
  const sec = parseGarminTime(str);
  if(sec===null) return null;
  return unit==='mile' ? sec/1.60934 : sec;
}
function getWeekStartLabel(dateObj){
  const d = new Date(dateObj);
  const day = (d.getDay()+6)%7; // 週一=0
  d.setDate(d.getDate()-day);
  d.setHours(0,0,0,0);
  return d;
}
function weekKey(d){ return localISODate(d); }
function monthKey(d){ return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`; }

