let charts = {};

// 三個圖表(跑量/配速趨勢/心率趨勢)共用的日期範圍篩選
let chartRangeMode = 'all'; // '4w' | '3m' | '6m' | '1y' | 'all' | 'custom'
let chartRangeStart = null; // Date | null
let chartRangeEnd = null;   // Date | null

function computePresetRange(preset){
  const end = new Date();
  end.setHours(23,59,59,999);
  if(preset==='all') return {start:null, end:null};
  const start = new Date(end);
  if(preset==='4w') start.setDate(start.getDate()-27);
  else if(preset==='3m') start.setMonth(start.getMonth()-3);
  else if(preset==='6m') start.setMonth(start.getMonth()-6);
  else if(preset==='1y') start.setFullYear(start.getFullYear()-1);
  start.setHours(0,0,0,0);
  return {start, end};
}
function getChartFilteredRuns(){
  if(!chartRangeStart && !chartRangeEnd) return RUNS;
  return RUNS.filter(r=>{
    const d = new Date(r.date);
    if(chartRangeStart && d < chartRangeStart) return false;
    if(chartRangeEnd && d > chartRangeEnd) return false;
    return true;
  });
}

// 找出目前資料裡實際存在的所有「週」或「月」,由新到舊排序
function getAvailablePeriods(mode){
  const map = new Map();
  RUNS.forEach(r=>{
    const d = new Date(r.date);
    let key, label;
    if(mode==='week'){
      const ws = getWeekStartLabel(d);
      key = weekKey(ws);
      label = `${ws.getFullYear()}/${ws.getMonth()+1}/${ws.getDate()} 那週`;
    }else{
      key = monthKey(d);
      label = key.replace('-','/') + ' 月';
    }
    if(!map.has(key)) map.set(key, label);
  });
  return Array.from(map.entries())
    .map(([key,label])=>({key,label}))
    .sort((a,b)=> b.key.localeCompare(a.key));
}

function statsForPeriod(mode, key){
  const runs = RUNS.filter(r=>{
    const d = new Date(r.date);
    return mode==='week' ? weekKey(getWeekStartLabel(d))===key : monthKey(d)===key;
  });
  const totalDist = runs.reduce((s,r)=>s+r.distanceKm,0);
  const count = runs.length;
  const avgPace = count ? runs.reduce((s,r)=>s+r.paceSecPerKm,0)/count : null;
  const hrRuns = runs.filter(r=>r.avgHr);
  const avgHr = hrRuns.length ? hrRuns.reduce((s,r)=>s+r.avgHr,0)/hrRuns.length : null;
  return {totalDist, count, avgPace, avgHr};
}

function populateStatPeriodSelect(){
  const select = document.getElementById('statPeriodSelect');
  const periods = getAvailablePeriods(statPeriodMode);
  if(periods.length===0){
    select.innerHTML = '';
    statPeriodKey = null;
    return;
  }
  const now = new Date();
  const currentKey = statPeriodMode==='week' ? weekKey(getWeekStartLabel(now)) : monthKey(now);
  const keepPrevious = periods.some(p=>p.key===statPeriodKey);
  if(!keepPrevious){
    statPeriodKey = periods.some(p=>p.key===currentKey) ? currentKey : periods[0].key;
  }
  select.innerHTML = periods.map(p=>
    `<option value="${p.key}" ${p.key===statPeriodKey?'selected':''}>${p.label}</option>`
  ).join('');
}

function getPreviousPeriodKey(mode, key){
  if(mode==='week'){
    const d = new Date(key+'T00:00:00');
    d.setDate(d.getDate()-7);
    return weekKey(d);
  }
  const [y,m] = key.split('-').map(Number);
  const d = new Date(y, m-2, 1);
  return monthKey(d);
}

function renderPeriodSummary(mode, currentKey, currentStats){
  const el = document.getElementById('periodSummaryText');
  if(!currentKey || currentStats.count===0){
    el.textContent = '';
    return;
  }
  const prevKey = getPreviousPeriodKey(mode, currentKey);
  const prevStats = statsForPeriod(mode, prevKey);
  const periodWord = mode==='week' ? '這週' : '這個月';
  const prevWord = mode==='week' ? '上週' : '上個月';

  if(prevStats.count===0){
    el.innerHTML = `${periodWord}跑了 <b>${currentStats.totalDist.toFixed(1)}km</b>,共 ${currentStats.count} 次。${prevWord}沒有資料可以比較。`;
    return;
  }
  let text = `${periodWord}跑了 <b>${currentStats.totalDist.toFixed(1)}km</b>`;
  if(prevStats.totalDist>0){
    const pct = (currentStats.totalDist-prevStats.totalDist)/prevStats.totalDist*100;
    text += pct>=0 ? `,比${prevWord}多跑 <b>${pct.toFixed(0)}%</b>` : `,比${prevWord}少跑 <b>${Math.abs(pct).toFixed(0)}%</b>`;
  }
  if(currentStats.avgPace!=null && prevStats.avgPace!=null){
    const paceDiff = currentStats.avgPace - prevStats.avgPace; // 負數代表變快
    if(Math.abs(paceDiff)>=1){
      text += paceDiff<0 ? `,平均配速進步了 <b>${Math.round(Math.abs(paceDiff))}秒</b>` : `,平均配速慢了 <b>${Math.round(paceDiff)}秒</b>`;
    }
  }
  el.innerHTML = text + '。';
}

function renderGoalProgress(mode, totalDist){
  document.getElementById('goalPeriodLabel').textContent = mode==='week' ? '本週' : '本月';
  const goalVal = GOALS[mode];
