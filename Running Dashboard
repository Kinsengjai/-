<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>跑步紀錄 / 訓練分析</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f5f6f3;
    --panel:#ffffff;
    --ink:#1c2321;
    --ink-soft:#5c655f;
    --line:#dde1dc;
    --pine:#2f5233;
    --pine-soft:#e6ede6;
    --amber:#e8a33d;
    --amber-soft:#fbecd5;
    --danger:#b3452f;
    --radius:10px;
  }
  body.dark-mode{
    --bg:#171d18;
    --panel:#212a22;
    --ink:#eef1ea;
    --ink-soft:#9aa89d;
    --line:#324035;
    --pine:#5b9467;
    --pine-soft:#233a29;
    --amber:#e8a33d;
    --amber-soft:#3a2f16;
    --danger:#e0705a;
  }
  body.dark-mode .empty-state{color:var(--ink-soft);}
  body.dark-mode .stat-card{border-color:var(--line);}
  body.dark-mode .grid-stats-sm .stat-card{background:var(--pine-soft);}
  body.dark-mode .drop{background:#1a221b;}
  body.dark-mode .modal{box-shadow:0 20px 50px rgba(0,0,0,.5);}
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      repeating-linear-gradient(115deg, rgba(47,82,51,.05) 0, rgba(47,82,51,.05) 1px, transparent 1px, transparent 72px),
      radial-gradient(circle at 14% 6%, rgba(232,163,61,.12), transparent 42%),
      radial-gradient(circle at 88% 92%, rgba(47,82,51,.07), transparent 40%),
      var(--bg);
    background-attachment:fixed;
    color:var(--ink);
    font-family:'Inter',sans-serif;
    display:flex;
    min-height:100vh;
  }
  .mono{font-family:'IBM Plex Mono',monospace;}
  h1,h2,h3,.brand,.nav-item,.stat-value{font-family:'Space Grotesk',sans-serif;}

  /* ---------- Sidebar ---------- */
  .sidebar{
    width:220px;
    flex-shrink:0;
    background:linear-gradient(190deg, #274a2e 0%, #182d1c 100%);
    padding:28px 18px;
    display:flex;
    flex-direction:column;
    gap:26px;
    box-shadow:1px 0 0 rgba(0,0,0,.06);
  }
  .brand{font-size:19px;font-weight:700;line-height:1.25;color:#f3d9a6;}
  .brand span{display:block;font-size:12px;font-weight:500;color:rgba(238,241,234,.6);font-family:'Inter',sans-serif;margin-top:4px;}
  nav{display:flex;flex-direction:column;gap:4px;}
  .nav-item{
    text-align:left;
    background:none;
    border:none;
    padding:10px 12px;
    border-radius:8px;
    font-size:14.5px;
    font-weight:600;
    color:rgba(238,241,234,.72);
    cursor:pointer;
  }
  .nav-item:hover{background:rgba(255,255,255,.07);color:#fff;}
  .nav-item.active{background:rgba(232,163,61,.16);color:#f3c467;}
  .sidebar-foot{margin-top:auto;font-size:12px;color:rgba(238,241,234,.5);line-height:1.6;}
  .sidebar-foot button{
    margin-top:10px;
    width:100%;
    background:none;
    border:1px solid rgba(238,241,234,.22);
    border-radius:8px;
    padding:7px;
    font-size:12px;
    color:#e6a693;
    cursor:pointer;
    font-family:'Inter',sans-serif;
  }
  .sidebar-foot button:hover{background:rgba(179,69,47,.25);border-color:rgba(179,69,47,.4);}

  /* ---------- Main ---------- */
  main{flex:1;padding:32px 40px;max-width:1100px;}
  .page{display:none;}
  .page.active{display:block;}
  .page-title{font-size:22px;font-weight:700;margin:0 0 4px;}
  .page-sub{color:var(--ink-soft);font-size:14px;margin:0 0 26px;}

  .card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:20px 22px;
  }
  .grid-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px;}
  .grid-stats-sm{grid-template-columns:repeat(2,1fr);max-width:420px;}
  .grid-stats-sm .stat-card{background:var(--pine-soft);border-color:transparent;}
  .period-bar{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap;}
  .period-bar select{
    border:1px solid var(--line);border-radius:7px;padding:6px 10px;font-size:13px;font-family:'IBM Plex Mono',monospace;background:var(--panel);color:var(--ink);
  }
  .period-hint{font-size:12.5px;color:var(--ink-soft);}
  .range-bar{display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap;}
  .range-label{font-size:13px;font-weight:600;color:var(--ink-soft);}
  .range-custom{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-soft);}
  .range-custom input[type=date]{
    border:1px solid var(--line);border-radius:7px;padding:6px 9px;font-size:13px;font-family:'IBM Plex Mono',monospace;background:var(--panel);color:var(--ink);
  }
  .stat-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;}
  .stat-label{font-size:12.5px;color:var(--ink-soft);margin-bottom:8px;}
  .stat-value{font-size:22px;font-weight:600;font-family:'IBM Plex Mono',monospace;}
  .stat-value small{font-size:13px;font-weight:500;color:var(--ink-soft);margin-left:2px;}
  .summary-text{
    font-size:13.5px;color:var(--ink-soft);background:var(--pine-soft);border-radius:8px;padding:11px 14px;margin:0 0 18px;line-height:1.6;
  }
  .summary-text b{color:var(--pine);font-weight:700;}
  .goal-card{}
  .goal-head{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:12px;}
  .goal-input-row{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--ink-soft);}
  .goal-input-row input{
    width:80px;border:1px solid var(--line);border-radius:7px;padding:6px 9px;font-size:13px;font-family:'IBM Plex Mono',monospace;background:var(--panel);color:var(--ink);
  }
  .goal-progress-bg{background:var(--bg);border-radius:8px;height:14px;overflow:hidden;}
  .goal-progress-fill{height:100%;background:var(--pine);border-radius:8px;transition:width .3s;}
  .goal-progress-fill.warn{background:var(--amber);}
  .goal-progress-fill.over{background:var(--danger);}
  .goal-progress-label{font-size:12.5px;color:var(--ink-soft);margin-top:6px;}
  .week-plan-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;}
  .week-plan-day{border:1px solid var(--line);border-radius:8px;padding:10px 8px;min-height:88px;background:var(--bg);}
  .week-plan-day.is-today{border-color:var(--amber);background:var(--amber-soft);}
  .week-plan-daylabel{font-size:12.5px;font-weight:700;color:var(--ink-soft);display:flex;justify-content:space-between;align-items:center;margin-bottom:2px;}
  .week-plan-date{font-size:11px;color:var(--ink-soft);margin-bottom:6px;font-family:'IBM Plex Mono',monospace;}
  .week-plan-tag{font-size:12.5px;font-weight:600;color:var(--pine);margin-bottom:2px;}
  .week-plan-detail{font-size:11px;color:var(--ink-soft);font-family:'IBM Plex Mono',monospace;line-height:1.5;}
  .week-plan-empty{font-size:12px;color:var(--ink-soft);opacity:.5;}
  .week-plan-status{font-size:12px;}
  .week-plan-status.done{color:var(--pine);}
  .week-plan-status.missed{color:var(--danger);}
  .band-group-head{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15px;margin:16px 0 8px;}
  .band-group-sub{font-weight:400;font-size:12.5px;color:var(--ink-soft);margin-left:8px;font-family:'Inter',sans-serif;}
  .feeling-picker{display:flex;gap:6px;}
  .feeling-btn{border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:6px 12px;font-size:18px;cursor:pointer;opacity:.45;line-height:1;}
  .feeling-btn:hover{opacity:.8;}
  .feeling-btn.active{opacity:1;border-color:var(--pine);background:var(--pine-soft);}
  .filter-bar{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap;}
  .filter-bar select,.filter-bar input{
    border:1px solid var(--line);border-radius:7px;padding:7px 10px;font-size:13px;font-family:'IBM Plex Mono',monospace;background:var(--panel);color:var(--ink);
  }
  .filter-bar input{width:130px;}
  .heatmap-month-row{position:relative;height:14px;margin-left:24px;font-size:10.5px;color:var(--ink-soft);}
  .heatmap-month-row span{position:absolute;top:0;white-space:nowrap;}
  .heatmap-flex{display:flex;gap:6px;}
  .heatmap-weekdays{display:flex;flex-direction:column;gap:3px;font-size:10px;color:var(--ink-soft);width:16px;text-align:right;}
  .heatmap-weekdays div{height:12px;line-height:12px;}
  .heatmap{display:flex;gap:3px;overflow-x:auto;padding-bottom:6px;}
  .heatmap-col{display:flex;flex-direction:column;gap:3px;}
  .heatmap-cell{width:12px;height:12px;border-radius:3px;background:var(--bg);}
  .heatmap-cell[data-level="1"]{background:#bcdcc2;}
  .heatmap-cell[data-level="2"]{background:#7ab689;}
  .heatmap-cell[data-level="3"]{background:#3f8a55;}
  .heatmap-cell[data-level="4"]{background:var(--pine);}
  .heatmap-cell[data-today="1"]{outline:1.5px solid var(--amber);outline-offset:-1px;}
  .heatmap-legend{display:flex;align-items:center;gap:5px;font-size:11.5px;color:var(--ink-soft);margin-top:8px;}
  .heatmap-legend .heatmap-cell{width:10px;height:10px;}
  .heatmap-legend .heatmap-today-note{display:flex;align-items:center;gap:4px;margin-left:14px;}

  .chart-row{display:grid;grid-template-columns:1.15fr 1fr;gap:16px;margin-bottom:16px;}
  .chart-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px;}
  .chart-card h3{margin:0 0 2px;font-size:14.5px;}
  .chart-card .hint{font-size:12px;color:var(--ink-soft);margin:0 0 12px;}
  .chart-wrap{position:relative;height:230px;}
  .toggle-group{display:inline-flex;border:1px solid var(--line);border-radius:7px;overflow:hidden;margin-bottom:12px;}
  .toggle-group button{
    border:none;background:var(--panel);padding:5px 12px;font-size:12.5px;cursor:pointer;color:var(--ink-soft);font-family:'Inter',sans-serif;
  }
  .toggle-group button.active{background:var(--pine);color:#fff;}

  /* ---------- Forms ---------- */
  .field-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:14px;}
  .field{display:flex;flex-direction:column;gap:6px;}
  .field label{font-size:12.5px;color:var(--ink-soft);font-weight:600;}
  .field input,.field select{
    border:1px solid var(--line);border-radius:7px;padding:9px 10px;font-size:14px;font-family:'IBM Plex Mono',monospace;background:var(--panel);color:var(--ink);
  }
  .field.wide{grid-column:span 3;}
  .field input[type=text],.field input[type=date]{font-family:'IBM Plex Mono',monospace;}
  .duration-row{display:flex;gap:8px;align-items:center;}
  .duration-row input{width:64px;text-align:center;}
  .duration-row span{color:var(--ink-soft);font-size:13px;}
  .btn{
    border:none;border-radius:8px;padding:10px 18px;font-size:14px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;
  }
  .btn-primary{background:var(--pine);color:#fff;}
  .btn-primary:hover{background:#264429;}
  .btn-secondary{background:var(--bg);color:var(--ink);border:1px solid var(--line);}
  .btn-secondary:hover{background:#ebebe6;}
  .btn-amber{background:var(--amber);color:#3b2a05;}
  .btn-amber:hover{background:#d9922f;}
  .form-actions{display:flex;gap:10px;margin-top:6px;}
  .msg{font-size:13px;margin-top:10px;padding:9px 12px;border-radius:7px;display:none;}
  .msg.ok{display:block;background:var(--pine-soft);color:var(--pine);}
  .msg.err{display:block;background:#fbeceb;color:var(--danger);}

  /* ---------- Import ---------- */
  .drop{
    border:1.5px dashed var(--line);border-radius:var(--radius);padding:34px 20px;text-align:center;color:var(--ink-soft);background:#fbfbf9;margin-bottom:18px;
  }
  .drop input{display:none;}
  .drop label{color:var(--pine);font-weight:600;cursor:pointer;}
  .drop.dragover{border-color:var(--pine);background:var(--pine-soft);}
  .preview-note{font-size:13px;color:var(--ink-soft);margin-bottom:10px;}
  table{width:100%;border-collapse:collapse;font-size:13px;}
  th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);}
  th{color:var(--ink-soft);font-weight:600;font-size:12px;}
  td.mono,th.mono{font-family:'IBM Plex Mono',monospace;}
  tbody tr.clickable{cursor:pointer;}
  tbody tr.clickable:hover{background:var(--bg);}
  .table-wrap{max-height:420px;overflow:auto;border:1px solid var(--line);border-radius:var(--radius);}
  .table-wrap table{border:none;}
  .table-wrap th{position:sticky;top:0;background:var(--panel);}
  .empty-state{padding:40px 20px;text-align:center;color:var(--ink-soft);font-size:14px;}

  /* ---------- Modal ---------- */
  .overlay{
    position:fixed;inset:0;background:rgba(20,24,20,.42);display:none;align-items:center;justify-content:center;z-index:50;
  }
  .overlay.show{display:flex;}
  .modal{
    background:var(--panel);border-radius:12px;padding:26px 28px;width:480px;max-width:92vw;max-height:88vh;overflow-y:auto;box-shadow:0 20px 50px rgba(0,0,0,.18);
  }
  .modal h3{margin:0 0 2px;font-size:18px;}
  .modal .sub{color:var(--ink-soft);font-size:13px;margin:0 0 18px;}
  .detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 18px;margin-bottom:20px;}
  .detail-item .l{font-size:12px;color:var(--ink-soft);margin-bottom:4px;}
  .detail-item .v{font-size:16px;font-weight:600;font-family:'IBM Plex Mono',monospace;}
  .detail-edit-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
  .detail-edit-row .field label{font-size:12px;}
  .detail-edit-row select,.detail-edit-row input{
    width:100%;border:1px solid var(--line);border-radius:7px;padding:8px 9px;font-size:13.5px;font-family:'IBM Plex Mono',monospace;background:var(--panel);color:var(--ink);
  }
  .pace-readonly{
    font-size:13px;color:var(--ink-soft);margin:6px 0 16px;padding-top:14px;border-top:1px solid var(--line);
  }
  .pace-readonly b{color:var(--ink);font-family:'IBM Plex Mono',monospace;}
  .modal-actions{display:flex;justify-content:space-between;align-items:center;}
  .shoe-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin-bottom:12px;}
  .shoe-card.retired{opacity:.55;}
  .shoe-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;flex-wrap:wrap;gap:6px;}
  .shoe-name{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15.5px;}
  .shoe-meta{font-size:12.5px;color:var(--ink-soft);}
  .shoe-progress-bg{background:var(--bg);border-radius:6px;height:8px;overflow:hidden;margin:8px 0;}
  .shoe-progress-fill{height:100%;background:var(--pine);border-radius:6px;}
  .shoe-progress-fill.warn{background:var(--amber);}
  .shoe-progress-fill.over{background:var(--danger);}
  .shoe-actions{display:flex;gap:8px;margin-top:10px;}
  .shoe-actions button{
    border:1px solid var(--line);background:var(--panel);border-radius:7px;padding:5px 11px;font-size:12.5px;cursor:pointer;font-family:'Inter',sans-serif;color:var(--ink-soft);
  }
  .shoe-actions button:hover{background:var(--bg);}

  @media (max-width:880px){
    body{flex-direction:column;}
    .sidebar{width:100%;flex-direction:row;align-items:center;padding:14px 18px;overflow-x:auto;}
    .sidebar-foot{display:none;}
    nav{flex-direction:row;}
    main{padding:20px;}
    .grid-stats{grid-template-columns:repeat(2,1fr);}
    .chart-row{grid-template-columns:1fr;}
    .field-row{grid-template-columns:1fr 1fr;}
    .field.wide{grid-column:span 2;}
    .week-plan-grid{grid-template-columns:repeat(4,1fr);}
  }
</style>
</head>
<body>

<div class="sidebar">
  <div class="brand">跑步紀錄<span>私人本機訓練分析</span></div>
  <nav>
    <button class="nav-item active" data-page="dashboard">總覽</button>
    <button class="nav-item" data-page="import">匯入 CSV</button>
    <button class="nav-item" data-page="manual">手動輸入</button>
    <button class="nav-item" data-page="history">跑步歷史</button>
    <button class="nav-item" data-page="bands">區間分析</button>
    <button class="nav-item" data-page="shoes">跑鞋</button>
    <button class="nav-item" data-page="plan">訓練計畫</button>
  </nav>
  <div class="sidebar-foot">
    <button id="darkModeBtn" type="button">🌙 深色模式</button>
    <button id="exportBtn" type="button">匯出備份(JSON)</button>
    <button id="importBtn" type="button">匯入備份</button>
    <input type="file" id="importFileInput" accept=".json" style="display:none;">
    資料只存在這台電腦的瀏覽器中,不會上傳。
    <button id="wipeBtn" type="button">清除所有資料</button>
  </div>
</div>

<main>

  <!-- ===== Dashboard ===== -->
  <section class="page active" id="page-dashboard">
    <h1 class="page-title">總覽</h1>
    <p class="page-sub">你的跑步狀態一覽</p>

    <div class="period-bar">
      <div class="toggle-group" id="statPeriodToggle">
        <button class="active" data-mode="week">週</button>
        <button data-mode="month">月</button>
      </div>
      <select id="statPeriodSelect"></select>
    </div>

    <div class="grid-stats" id="statCards"></div>

    <div class="grid-stats grid-stats-sm" id="statCardsAllTime"></div>

    <p class="summary-text" id="periodSummaryText"></p>

    <div class="card goal-card" style="margin-bottom:22px;">
      <div class="goal-head">
        <h3 style="margin:0;">目標進度(<span id="goalPeriodLabel">本週</span>)</h3>
        <div class="goal-input-row">
          <input type="text" id="goalInput" placeholder="例如 30">
          <span>km</span>
          <button class="btn btn-secondary" id="saveGoalBtn">設定</button>
        </div>
      </div>
      <div id="goalProgressWrap"></div>
    </div>

    <div class="chart-card" style="margin-bottom:22px;">
      <h3>本週訓練計畫</h3>
      <p class="hint">週一到週日,對照當天有沒有排定的計畫</p>
      <div id="weekPlanWrap"></div>
    </div>

    <div class="range-bar">
      <span class="range-label">圖表範圍</span>
      <div class="toggle-group" id="rangePreset">
        <button data-range="4w">近4週</button>
        <button data-range="3m">近3個月</button>
        <button data-range="6m">近6個月</button>
        <button data-range="1y">近1年</button>
        <button class="active" data-range="all">全部</button>
      </div>
      <div class="range-custom">
        <input type="date" id="rangeStart">
        <span>至</span>
        <input type="date" id="rangeEnd">
      </div>
    </div>

    <div class="chart-card" style="margin-bottom:16px;">
      <h3>跑量</h3>
      <p class="hint">每週 / 每月累積距離</p>
      <div class="toggle-group" id="volumeToggle">
        <button class="active" data-mode="week">依週</button>
        <button data-mode="month">依月</button>
      </div>
      <div class="chart-wrap"><canvas id="volumeChart"></canvas></div>
    </div>

    <div class="chart-row">
      <div class="chart-card">
        <h3>配速趨勢</h3>
        <p class="hint">每次跑步的平均配速(分鐘/公里,越靠上代表越快)</p>
        <div class="chart-wrap"><canvas id="paceChart"></canvas></div>
      </div>
      <div class="chart-card">
        <h3>平均心率趨勢</h3>
        <p class="hint">每次跑步的平均心率(bpm)</p>
        <div class="chart-wrap"><canvas id="hrChart"></canvas></div>
      </div>
    </div>

    <div class="chart-row">
      <div class="chart-card">
        <h3>跑鞋里程</h3>
        <p class="hint">依「圖表範圍」加總各雙鞋的累積距離</p>
        <div class="chart-wrap"><canvas id="shoeChart"></canvas></div>
      </div>
      <div class="chart-card">
        <h3>訓練類型分佈</h3>
        <p class="hint">依「圖表範圍」統計各類型跑步的距離佔比</p>
        <div class="chart-wrap"><canvas id="tagChart"></canvas></div>
      </div>
    </div>

    <div class="chart-card" style="margin-bottom:16px;">
      <h3>月份比較(輕鬆跑 vs 速度課)</h3>
      <p class="hint">輕鬆跑包含輕鬆跑/LSD/恢復跑;速度課包含節奏跑/間歇跑/測試跑,比較每個月的累積距離</p>
