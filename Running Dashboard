/* =========================================================
   個人最佳紀錄(PR)——依全部歷史紀錄,不受圖表範圍影響
   ========================================================= */
const PR_DEFS = [
  {key:'5k', label:'5K', min:4.75, max:5.25},
  {key:'10k', label:'10K', min:9.5, max:10.5},
  {key:'half', label:'半馬', min:20.5, max:21.7},
  {key:'full', label:'全馬', min:41.0, max:43.0}
];
function computePRs(){
  return PR_DEFS.map(def=>{
    const bandCandidates = RUNS.filter(r=> r.distanceKm>=def.min && r.distanceKm<=def.max);
    const best = bandCandidates.length===0 ? null : bandCandidates.reduce((a,b)=> a.durationSec<b.durationSec ? a : b);

    // 「首次達成」用「距離有到門檻」就算,不限定在精確區間內,抓最早的一次
    const reachedCandidates = RUNS.filter(r=> r.distanceKm>=def.min);
    const firstRun = reachedCandidates.length===0 ? null : reachedCandidates.reduce((a,b)=> new Date(a.date)<new Date(b.date) ? a : b);

    return Object.assign({}, def, {best, firstRun});
  });
}
function renderPRCards(){
  const el = document.getElementById('prCards');
  el.innerHTML = computePRs().map(p=>{
    const bestHtml = p.best
      ? `<div class="stat-value">${formatDuration(p.best.durationSec)}</div><div class="period-hint">最佳・${formatDate(p.best.date)}・${p.best.distanceKm.toFixed(2)}km</div>`
      : `<div class="stat-value" style="font-size:15px;color:var(--ink-soft);">尚無紀錄</div>`;
    const firstHtml = p.firstRun
      ? `<div class="period-hint" style="margin-top:4px;">首次達成・${formatDate(p.firstRun.date)}</div>`
      : '';
    return `<div class="stat-card"><div class="stat-label">${p.label}</div>${bestHtml}${firstHtml}</div>`;
  }).join('');
}

// PR 配速趨勢:對每個距離區間,找出「每次刷新最佳紀錄的當下」,畫成一條逐步進步的折線
function computePRTrendSeries(){
  const progressions = PR_DEFS.map(def=>{
    const candidates = RUNS.filter(r=> r.distanceKm>=def.min && r.distanceKm<=def.max)
      .slice()
      .sort((a,b)=> new Date(a.date)-new Date(b.date));
    let bestSec = Infinity;
    const points = [];
    candidates.forEach(r=>{
      if(r.durationSec < bestSec){
        bestSec = r.durationSec;
        points.push({date:r.date, paceSecPerKm:r.paceSecPerKm});
      }
    });
    return {label:def.label, points};
  }).filter(p=>p.points.length>0);

  if(progressions.length===0) return null;

  const allDates = Array.from(new Set(progressions.flatMap(p=>p.points.map(pt=>pt.date)))).sort();
  const datasets = progressions.map((p,i)=>{
    const data = allDates.map(d=>{
      let val = null;
      for(const pt of p.points){ if(pt.date<=d) val = pt.paceSecPerKm; else break; }
      return val;
    });
    return {
      label: p.label,
      data,
      borderColor: TAG_CHART_COLORS[i%TAG_CHART_COLORS.length],
      backgroundColor: TAG_CHART_COLORS[i%TAG_CHART_COLORS.length],
      spanGaps: true,
      stepped: true,
      pointRadius: 3,
      tension: 0
    };
  });
  return {labels: allDates.map(d=>formatDate(d)), datasets};
}
function renderPRTrendChart(){
  destroyChart('prTrend');
  const canvas = document.getElementById('prTrendChart');
  const wrap = canvas.parentElement;
  let emptyEl = wrap.querySelector('.empty-state');
  const series = computePRTrendSeries();

  if(!series || typeof Chart==='undefined'){
    canvas.style.display = 'none';
    if(!emptyEl){ emptyEl = document.createElement('div'); emptyEl.className = 'empty-state'; wrap.appendChild(emptyEl); }
    emptyEl.textContent = '還沒有足夠的 5K / 10K / 半馬 / 全馬 距離紀錄可以畫趨勢。';
    return;
  }
  canvas.style.display = '';
  if(emptyEl) emptyEl.remove();

  charts.prTrend = new Chart(canvas, {
    type:'line',
    data: series,
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{display:true, position:'top', labels:{boxWidth:12,font:{size:11}}}, tooltip:{ callbacks:{ label: c => `${c.dataset.label}:${formatPace(c.parsed.y)}` } } },
      scales:{ y:{ reverse:true, grid:{color:'#eceee9'}, ticks:{ callback:v=>formatPace(v) } }, x:{ grid:{display:false} } }
    }
  });
}

/* =========================================================
   區間分析:選平均心率段/平均配速段,依 5K、10K 列出符合的紀錄
