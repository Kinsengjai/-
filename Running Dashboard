const BAND_DISTANCE_GROUPS = PR_DEFS.slice(0,2); // 5K、10K(之後想加半馬/全馬,改成 PR_DEFS 即可)
const HR_BAND_WIDTH = 5;     // 心率每 5 bpm 一段:151-155、156-160...
const PACE_BAND_WIDTH = 15;  // 配速每 15 秒一段:7:00-7:15、7:15-7:30...(含下限、不含上限)

function paceMMSS(sec){
  const t = Math.round(sec);
  return `${Math.floor(t/60)}:${String(t%60).padStart(2,'0')}`;
}
function hrBandLow(hr){
  const h = Math.round(hr);
  return Math.floor((h-1)/HR_BAND_WIDTH)*HR_BAND_WIDTH + 1;
}
function paceBandLow(paceSec){
  return Math.floor(paceSec/PACE_BAND_WIDTH)*PACE_BAND_WIDTH;
}
function inBandDistanceGroup(r){
  return BAND_DISTANCE_GROUPS.some(g=> r.distanceKm>=g.min && r.distanceKm<=g.max);
}
function buildBandSelect(selectId, entries, placeholder){
