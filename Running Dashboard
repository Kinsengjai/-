  document.getElementById('d_editCadence').value = r.cadence ?? '';
  document.getElementById('d_paceReadonly').innerHTML = `平均配速:<b>${formatPace(r.paceSecPerKm)}</b>(依距離與時間自動計算)`;

  // 以下是選填欄位,CSV 裡有值才會顯示;這些欄位比較少用,先不開放直接編輯
  const items = [];
  if(r.calories) items.push(['卡路里', `${r.calories} kcal`]);
  if(r.elevGainM!=null) items.push(['總爬升', `${Math.round(r.elevGainM)} m`]);
  if(r.elevLossM!=null) items.push(['總下降', `${Math.round(r.elevLossM)} m`]);
  if(r.avgStrideM!=null) items.push(['平均步幅', `${r.avgStrideM.toFixed(2)} m`]);
  if(r.bestPaceSecPerKm!=null) items.push(['最佳配速', formatPace(r.bestPaceSecPerKm)]);
  if(r.trainingEffect!=null) items.push(['有氧訓練效果', r.trainingEffect.toFixed(1)]);
  if(r.tss!=null) items.push(['Training Stress Score', r.tss.toFixed(1)]);
  document.getElementById('d_grid').innerHTML = items.map(([l,v])=>
    `<div class="detail-item"><div class="l">${l}</div><div class="v">${v}</div></div>`
  ).join('');

  // 跑鞋/標籤:直接在詳情裡就能編輯,選了就立刻儲存
  const shoeSelect = document.getElementById('d_shoeSelect');
  const activeOrAssigned = SHOES.filter(s => !s.retired || s.id===r.shoeId);
  shoeSelect.innerHTML = '<option value="">未指定</option>' + activeOrAssigned.map(s=>
    `<option value="${s.id}" ${s.id===r.shoeId?'selected':''}>${s.name}${s.retired?'(已停用)':''}</option>`
  ).join('');
  document.getElementById('d_tagInput').value = r.tag || '';

  // 間歇組別:選了節奏/間歇才會顯示這幾個欄位
  const iv = r.intervals;
  document.getElementById('d_sets').value = iv ? (iv.sets ?? '') : '';
  document.getElementById('d_intervalUnit').value = iv ? iv.perUnit : 'distance';
  document.getElementById('d_intervalDistance').value = iv && iv.perDistanceM!=null ? iv.perDistanceM : '';
  document.getElementById('d_intervalTime').value = iv && iv.perTimeSec ? formatDuration(iv.perTimeSec) : '';
  document.getElementById('d_intervalPace').value = iv && iv.paceSecPerKm ? formatPace(iv.paceSecPerKm).replace(' /km','') : '';
  updateDetailIntervalVisibility();
  const ivIsTime = iv && iv.perUnit==='time';
  document.getElementById('d_intervalDistanceField').style.display = ivIsTime ? 'none' : '';
  document.getElementById('d_intervalTimeField').style.display = ivIsTime ? '' : 'none';

  // 感受評分
  setFeelingPickerValue('d_feelingPicker','d_feeling', r.feeling);

  document.getElementById('detailOverlay').classList.add('show');
}

// 核心欄位(標題/日期/距離/時間/心率/步頻/間歇/感受)改成隨時可編輯,異動就立刻存檔
function saveDetailCoreFields(){
  if(!currentDetailId) return;
  const r = RUNS.find(x=>x.id===currentDetailId);
  if(!r) return;

  const distance = parseFloat(document.getElementById('d_editDistance').value);
  const durationSec = parseDurationToSeconds(
    document.getElementById('d_editH').value,
    document.getElementById('d_editM').value,
    document.getElementById('d_editS').value
  );
  if(!(distance>0) || !(durationSec>0)) return; // 距離或時間不合理就先不存,避免資料壞掉

  r.title = document.getElementById('d_editTitle').value.trim() || null;
  r.date = document.getElementById('d_editDate').value || r.date;
  r.distanceKm = distance;
  r.durationSec = durationSec;
  r.paceSecPerKm = durationSec/distance;
  r.avgHr = parseFloat(document.getElementById('d_editAvgHr').value) || null;
  r.maxHr = parseFloat(document.getElementById('d_editMaxHr').value) || null;
  r.cadence = parseFloat(document.getElementById('d_editCadence').value) || null;

  const tag = document.getElementById('d_tagInput').value.trim();
  const isIntervalType = tag && (tag.includes('節奏') || tag.includes('間歇'));
  const sets = parseFloat(document.getElementById('d_sets').value);
  if(isIntervalType && sets>0){
    const unit = document.getElementById('d_intervalUnit').value;
    r.intervals = {
      sets,
      perUnit: unit,
      perDistanceM: unit==='distance' ? (parseFloat(document.getElementById('d_intervalDistance').value) || null) : null,
      perTimeSec: unit==='time' ? parseGarminTime(document.getElementById('d_intervalTime').value) : null,
      paceSecPerKm: parseGarminTime(document.getElementById('d_intervalPace').value) || null
    };
  }else{
    r.intervals = null;
  }
  r.feeling = parseFloat(document.getElementById('d_feeling').value) || null;

  saveRuns(RUNS);
  document.getElementById('d_paceReadonly').innerHTML = `平均配速:<b>${formatPace(r.paceSecPerKm)}</b>(依距離與時間自動計算)`;
  renderHistory();
  renderDashboard();
}
