<script>
/* =========================================================
   Chart.js 動態載入(多個 CDN 備援)
   ---------------------------------------------------------
   之前發現寫死單一 CDN 網址時,遇到那個網址失效(或被瀏覽器擴充功能/
   防火牆擋掉)圖表就整個掛掉,但 CSV 解析功能(PapaParse)還能正常運作,
   使用者只會看到「資料匯入成功、但圖表空白」。這裡改成依序嘗試多個
   來源,任一個成功就繼續。
   ========================================================= */
const CHART_JS_SOURCES = [
  'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js',
  'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js',
  'https://unpkg.com/chart.js@4.4.4/dist/chart.umd.min.js'
];
function loadScriptWithFallback(urls){
  return new Promise((resolve)=>{
    let i = 0;
    function tryNext(){
      if(i >= urls.length){ resolve(false); return; }
      const s = document.createElement('script');
      s.src = urls[i];
      s.onload = ()=> resolve(true);
      s.onerror = ()=>{ i++; tryNext(); };
      document.head.appendChild(s);
    }
    tryNext();
  });
}
const chartJsReady = loadScriptWithFallback(CHART_JS_SOURCES);

/* =========================================================
   資料儲存(存在瀏覽器 localStorage,只有這台電腦看得到)
   ========================================================= */
const STORAGE_KEY = 'runTracker.runs.v1';

function loadRuns(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : [];
  }catch(e){ return []; }
}
function saveRuns(runs){
  localStorage.setItem(STORAGE_KEY, JSON.stringify(runs));
}
let RUNS = loadRuns();

function addRuns(newRuns){
  // 用「日期+距離+時間」當作重複判斷的依據,避免同一筆 CSV 重複匯入
  const existingKeys = new Set(RUNS.map(r => `${r.date}|${r.distanceKm.toFixed(2)}|${r.durationSec}`));
  let added = 0;
  newRuns.forEach(r=>{
    const key = `${r.date}|${r.distanceKm.toFixed(2)}|${r.durationSec}`;
    if(!existingKeys.has(key)){
      RUNS.push(r);
      existingKeys.add(key);
      added++;
    }
  });
  RUNS.sort((a,b)=> new Date(b.date) - new Date(a.date));
  saveRuns(RUNS);
  return added;
}
function deleteRun(id){
  RUNS = RUNS.filter(r=>r.id!==id);
  saveRuns(RUNS);
}

/* =========================================================
   跑鞋資料儲存
   ========================================================= */
const SHOES_STORAGE_KEY = 'runTracker.shoes.v1';
function loadShoes(){
  try{
    const raw = localStorage.getItem(SHOES_STORAGE_KEY);
    return raw ? JSON.parse(raw) : [];
  }catch(e){ return []; }
}
function saveShoes(shoes){
  localStorage.setItem(SHOES_STORAGE_KEY, JSON.stringify(shoes));
}
let SHOES = loadShoes();

function addShoe(shoe){
  SHOES.push(shoe);
  saveShoes(SHOES);
}
function setShoeRetired(id, retired){
  const s = SHOES.find(x=>x.id===id);
  if(s){ s.retired = retired; saveShoes(SHOES); }
}
function deleteShoe(id){
  SHOES = SHOES.filter(s=>s.id!==id);
  saveShoes(SHOES);
  // 這雙鞋底下的跑步紀錄改標成「未指定」,不會被一起刪掉
  RUNS.forEach(r=>{ if(r.shoeId===id) r.shoeId = null; });
  saveRuns(RUNS);
}
function getShoeName(id){
  if(!id) return null;
  const s = SHOES.find(x=>x.id===id);
  return s ? s.name : null;
}
function shoeStats(id){
  const runs = RUNS.filter(r=>r.shoeId===id);
  const km = runs.reduce((s,r)=>s+r.distanceKm,0);
  return {km, count: runs.length};
}

/* =========================================================
   週/月目標
   ========================================================= */
const GOALS_KEY = 'runTracker.goals.v1';
function loadGoals(){
  try{ return JSON.parse(localStorage.getItem(GOALS_KEY)) || {week:null, month:null}; }
  catch(e){ return {week:null, month:null}; }
}
