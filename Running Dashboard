/* =========================================================
   CSV 匯入
   ========================================================= */
const COLUMN_ALIASES = {
  activityType: ['Activity Type','活動類型'],
  date: ['Date','日期'],
  title: ['Title','標題'],
  distance: ['Distance','距離'],
  time: ['Moving Time','移動時間','Time','時間'],
  avgHr: ['Avg HR','Average HR','平均心率'],
  maxHr: ['Max HR','最大心率','最高心率'],
  cadence: ['Avg Run Cadence','Avg Cadence','平均步頻'],
  calories: ['Calories','卡路里'],
  elevGain: ['Total Ascent','總爬升'],
  elevLoss: ['Total Descent','總下降'],
  avgStride: ['Avg Stride Length','平均步幅'],
  bestPace: ['Best Pace','最佳配速'],
  trainingEffect: ['Aerobic TE','Aerobic Training Effect','有氧訓練效果'],
  tss: ['Training Stress Score','Training Stress Score®']
};
function findColumn(headers, aliases){
  for(const a of aliases){
    const hit = headers.find(h => h.trim().toLowerCase() === a.toLowerCase());
    if(hit) return hit;
  }
  // 模糊比對:包含關係
  for(const a of aliases){
    const hit = headers.find(h => h.toLowerCase().includes(a.toLowerCase()));
    if(hit) return hit;
  }
  return null;
}

let pendingImport = [];

function showImportMsg(kind, text){
  const importMsg = document.getElementById('importMsg');
  importMsg.className = 'msg ' + kind;
  importMsg.textContent = text;
}

function handleCsvFile(file){
  const importMsg = document.getElementById('importMsg');
  importMsg.className = 'msg'; // 重置:交給 CSS class 控制顯示/隱藏,不要再用 inline style

  if(typeof Papa === 'undefined'){
    showImportMsg('err', '無法載入 CSV 解析功能。請確認這台電腦目前有連上網路,然後重新整理頁面再試一次(PapaParse / Chart.js 需要第一次連網下載)。');
    return;
  }

  try{
    Papa.parse(file, {
    header:true,
    skipEmptyLines:true,
    complete: (results)=>{
      const headers = results.meta.fields || [];
      const col = {
        activityType: findColumn(headers, COLUMN_ALIASES.activityType),
        date: findColumn(headers, COLUMN_ALIASES.date),
        title: findColumn(headers, COLUMN_ALIASES.title),
        distance: findColumn(headers, COLUMN_ALIASES.distance),
        time: findColumn(headers, COLUMN_ALIASES.time),
        avgHr: findColumn(headers, COLUMN_ALIASES.avgHr),
        maxHr: findColumn(headers, COLUMN_ALIASES.maxHr),
        cadence: findColumn(headers, COLUMN_ALIASES.cadence),
        calories: findColumn(headers, COLUMN_ALIASES.calories),
        elevGain: findColumn(headers, COLUMN_ALIASES.elevGain),
        elevLoss: findColumn(headers, COLUMN_ALIASES.elevLoss),
        avgStride: findColumn(headers, COLUMN_ALIASES.avgStride),
        bestPace: findColumn(headers, COLUMN_ALIASES.bestPace),
        trainingEffect: findColumn(headers, COLUMN_ALIASES.trainingEffect),
        tss: findColumn(headers, COLUMN_ALIASES.tss)
      };

      if(!col.date || !col.distance || !col.time){
        importMsg.className = 'msg err';
        importMsg.textContent = '找不到必要欄位(日期 / 距離 / 時間),請確認這是 Garmin Connect 匯出的 Activities.csv。';
        return;
      }

      const unit = document.getElementById('csvUnit').value;
      const onlyRunning = document.getElementById('onlyRunning').checked;
      const RUN_KEYWORDS = ['run','跑步','跑','慢跑','trail','越野','treadmill','跑步機'];

      const parsed = [];
      let totalRows = 0, excludedByType = 0, excludedByParse = 0;

      results.data.forEach(row=>{
        totalRows++;
        if(onlyRunning && col.activityType){
          const type = (row[col.activityType]||'').toLowerCase();
          const isRunning = type && RUN_KEYWORDS.some(kw => type.includes(kw));
          if(type && !isRunning){ excludedByType++; return; }
        }
        const date = parseGarminDate(row[col.date]);
        const distanceKm = parseGarminDistance(row[col.distance], unit);
        const durationSec = parseGarminTime(row[col.time]);
        if(!date || !distanceKm || !durationSec){ excludedByParse++; return; }

        parsed.push({
          id: uid(),
          date,
          title: col.title ? (row[col.title]||'').trim() || null : null,
          distanceKm,
          durationSec,
          paceSecPerKm: durationSec/distanceKm,
          avgHr: col.avgHr ? (parseFloat(row[col.avgHr]) || null) : null,
          maxHr: col.maxHr ? (parseFloat(row[col.maxHr]) || null) : null,
          cadence: col.cadence ? (parseFloat(row[col.cadence]) || null) : null,
          calories: col.calories ? parseNum(row[col.calories]) : null,
          elevGainM: col.elevGain ? parseGarminSmallMetric(row[col.elevGain], unit) : null,
          elevLossM: col.elevLoss ? parseGarminSmallMetric(row[col.elevLoss], unit) : null,
          avgStrideM: col.avgStride ? parseGarminSmallMetric(row[col.avgStride], unit) : null,
          bestPaceSecPerKm: col.bestPace ? parseGarminPaceToSecPerKm(row[col.bestPace], unit) : null,
          trainingEffect: col.trainingEffect ? parseNum(row[col.trainingEffect]) : null,
          tss: col.tss ? parseNum(row[col.tss]) : null,
          shoeId: null,
          tag: null,
          intervals: null,
          feeling: null,
          source: 'csv'
        });
      });

      if(parsed.length===0){
        showImportMsg('err',
          `沒有找到可匯入的紀錄。共讀取 ${totalRows} 列;因活動類型判斷非跑步而排除 ${excludedByType} 列;`+
          `因日期/距離/時間格式無法辨識而跳過 ${excludedByParse} 列。`+
          (excludedByType>0 ? ' 可以試著取消勾選「只匯入跑步類活動」。' : '')+
          (excludedByParse>0 ? ' 也請確認上方的距離單位是否選對(公里/英里)。' : '')
        );
        return;
      }


      pendingImport = parsed.sort((a,b)=> new Date(b.date)-new Date(a.date));
      showPreview();
    },
    error: (err)=>{
      showImportMsg('err', '讀取 CSV 時發生錯誤:' + err.message);
    }
    });
  }catch(err){
    showImportMsg('err', '解析 CSV 時發生未預期的錯誤:' + err.message);
    console.error(err);
  }
}

function showPreview(){
  document.getElementById('previewArea').style.display = 'block';
  document.getElementById('previewNote').textContent = `偵測到 ${pendingImport.length} 筆跑步活動,請確認資料是否正確:`;
  document.getElementById('previewBody').innerHTML = pendingImport.slice(0,50).map(r=>`
    <tr>
      <td>${formatDate(r.date)}</td>
      <td>${r.title || '—'}</td>
      <td class="mono">${r.distanceKm.toFixed(2)}</td>
      <td class="mono">${formatDuration(r.durationSec)}</td>
      <td class="mono">${formatPace(r.paceSecPerKm)}</td>
      <td class="mono">${r.avgHr ?? '—'}</td>
    </tr>
  `).join('');
}

document.getElementById('confirmImportBtn').addEventListener('click', ()=>{
  const added = addRuns(pendingImport);
  const importMsg = document.getElementById('importMsg');
  importMsg.className = 'msg ok';
  importMsg.textContent = `已匯入 ${added} 筆新紀錄(${pendingImport.length - added} 筆因重複而略過)。`;
  document.getElementById('previewArea').style.display = 'none';
  pendingImport = [];
  document.getElementById('fileInput').value = '';
  renderDashboard();
  renderHistory();
});
document.getElementById('cancelImportBtn').addEventListener('click', ()=>{
  pendingImport = [];
  document.getElementById('previewArea').style.display = 'none';
  document.getElementById('fileInput').value = '';
});

document.getElementById('fileInput').addEventListener('change', (e)=>{
  if(e.target.files[0]) handleCsvFile(e.target.files[0]);
});
const dropZone = document.getElementById('dropZone');
dropZone.addEventListener('dragover', e=>{ e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', ()=> dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', e=>{
