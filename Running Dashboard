  document.getElementById('p_distance').value = p.distanceKm ?? '';
  document.getElementById('p_tag').value = p.tag || '';
  document.getElementById('p_note').value = p.note || '';
  document.getElementById('p_expectedPace').value = p.expectedPaceSecPerKm ? formatPace(p.expectedPaceSecPerKm).replace(' /km','') : '';
  document.getElementById('p_completedDate').value = p.completedDate || '';
  if(p.intervals){
    document.getElementById('p_sets').value = p.intervals.sets ?? '';
    document.getElementById('p_intervalUnit').value = p.intervals.perUnit;
    document.getElementById('p_intervalDistance').value = p.intervals.perDistanceM ?? '';
    document.getElementById('p_intervalTime').value = p.intervals.perTimeSec ? formatDuration(p.intervals.perTimeSec) : '';
    document.getElementById('p_intervalPace').value = p.intervals.paceSecPerKm ? formatPace(p.intervals.paceSecPerKm).replace(' /km','') : '';
    document.getElementById('p_intervalDistanceField').style.display = p.intervals.perUnit==='time' ? 'none' : '';
    document.getElementById('p_intervalTimeField').style.display = p.intervals.perUnit==='time' ? '' : 'none';
  }else{
    document.getElementById('p_sets').value = '';
    document.getElementById('p_intervalDistance').value = '';
    document.getElementById('p_intervalTime').value = '';
    document.getElementById('p_intervalPace').value = '';
  }
  updateIntervalFieldsVisibility();
  document.getElementById('addPlanBtn').textContent = '儲存修改';
  document.getElementById('cancelPlanEditBtn').style.display = '';
  document.getElementById('planMsg').className = 'msg';
  document.getElementById('page-plan').scrollIntoView({behavior:'smooth', block:'start'});
}
function exitPlanEditMode(){
  editingPlanId = null;
  document.getElementById('addPlanBtn').textContent = '加入計畫';
  document.getElementById('cancelPlanEditBtn').style.display = 'none';
  resetPlanForm();
}
document.getElementById('cancelPlanEditBtn').addEventListener('click', exitPlanEditMode);

document.getElementById('addPlanBtn').addEventListener('click', ()=>{
  const msg = document.getElementById('planMsg');
  const date = document.getElementById('p_date').value;
  if(!date){
    msg.className = 'msg err';
    msg.textContent = '請至少選擇日期。';
    return;
  }
  const tag = document.getElementById('p_tag').value.trim() || null;
  let intervals = null;
  const isIntervalType = tag && (tag.includes('節奏') || tag.includes('間歇'));
  const sets = parseFloat(document.getElementById('p_sets').value);
  if(isIntervalType && sets>0){
    const unit = document.getElementById('p_intervalUnit').value;
    const perDistanceM = parseFloat(document.getElementById('p_intervalDistance').value) || null;
    const perTimeSec = parseGarminTime(document.getElementById('p_intervalTime').value);
    const paceSecPerKm = parseGarminTime(document.getElementById('p_intervalPace').value);
    intervals = {
      sets,
      perUnit: unit,
      perDistanceM: unit==='distance' ? perDistanceM : null,
      perTimeSec: unit==='time' ? perTimeSec : null,
      paceSecPerKm: paceSecPerKm || null
    };
  }
  const expectedPaceSecPerKm = parseGarminTime(document.getElementById('p_expectedPace').value) || null;
  const entry = {
    date,
    distanceKm: parseFloat(document.getElementById('p_distance').value) || null,
    tag,
    note: document.getElementById('p_note').value.trim() || null,
    expectedPaceSecPerKm,
    completedDate: document.getElementById('p_completedDate').value || null,
    intervals
  };

  if(editingPlanId){
    const p = PLAN.find(x=>x.id===editingPlanId);
    if(p) Object.assign(p, entry);
    savePlan(PLAN);
    msg.className = 'msg ok';
    msg.textContent = '已儲存修改。';
    exitPlanEditMode();
  }else{
    PLAN.push(Object.assign({id: uid()}, entry));
    savePlan(PLAN);
    msg.className = 'msg ok';
    msg.textContent = '已加入計畫。';
    resetPlanForm();
  }
  renderPlanPage();
});

/* =========================================================
   JSON 備份匯出/匯入
   ========================================================= */
function exportBackup(){
  const data = {
    version: 1,
    exportedAt: new Date().toISOString(),
    runs: RUNS,
    shoes: SHOES,
    goals: GOALS,
    plan: PLAN
  };
  const blob = new Blob([JSON.stringify(data, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `running-tracker-backup-${localISODate(new Date())}.json`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}
document.getElementById('exportBtn').addEventListener('click', exportBackup);
document.getElementById('importBtn').addEventListener('click', ()=>{
  document.getElementById('importFileInput').click();
});
document.getElementById('importFileInput').addEventListener('change', (e)=>{
  const file = e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = ()=>{
    try{
      const data = JSON.parse(reader.result);
      if(!confirm('匯入備份會把備份檔裡的資料合併進目前的紀錄(重複的跑步紀錄會自動略過),確定要繼續嗎?')){
        document.getElementById('importFileInput').value = '';
        return;
      }
      if(Array.isArray(data.shoes)){
        data.shoes.forEach(s=>{ if(!SHOES.some(x=>x.id===s.id)) SHOES.push(s); });
        saveShoes(SHOES);
      }
      if(Array.isArray(data.runs)) addRuns(data.runs);
      if(Array.isArray(data.plan)){
        data.plan.forEach(p=>{ if(!PLAN.some(x=>x.id===p.id)) PLAN.push(p); });
        savePlan(PLAN);
      }
      if(data.goals && typeof data.goals==='object'){
        GOALS = Object.assign({}, GOALS, data.goals);
        saveGoals(GOALS);
      }
      refreshShoeSelects();
      refreshTagDatalist();
      renderDashboard();
      renderHistory();
      renderShoesPage();
      renderPlanPage();
      alert('備份還原完成。');
    }catch(err){
      alert('這個檔案看起來不是有效的備份檔:' + err.message);
    }
    document.getElementById('importFileInput').value = '';
  };
  reader.readAsText(file);
});

