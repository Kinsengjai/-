// 輕鬆跑:輕鬆跑/LSD/恢復跑;速度課:節奏跑/間歇跑/測試跑(不分大小寫、允許「跑」字變化寫法)
let monthCompareMode = 'km'; // 'km' | 'percent'
const EASY_RUN_KEYWORDS = ['輕鬆','lsd','恢復'];
const SPEED_RUN_KEYWORDS = ['節奏','間歇','測試'];
function classifyRunCategory(tag){
  const t = (tag||'').toLowerCase();
  if(EASY_RUN_KEYWORDS.some(kw=>t.includes(kw))) return 'easy';
  if(SPEED_RUN_KEYWORDS.some(kw=>t.includes(kw))) return 'speed';
  return null;
}
function renderMonthCompareChart(){
  destroyChart('monthCompare');
  const canvas = document.getElementById('monthCompareChart');
  const wrap = canvas.parentElement;
  let emptyEl = wrap.querySelector('.empty-state');

  const runs = getChartFilteredRuns().filter(r=> classifyRunCategory(r.tag)!==null);

  if(runs.length===0 || typeof Chart==='undefined'){
    canvas.style.display = 'none';
    if(!emptyEl){ emptyEl = document.createElement('div'); emptyEl.className = 'empty-state'; wrap.appendChild(emptyEl); }
    emptyEl.textContent = RUNS.length===0
      ? '還沒有資料,先去「匯入 CSV」或「手動輸入」新增一筆跑步紀錄吧。'
      : '所選範圍內沒有標記輕鬆跑/LSD/恢復跑或節奏跑/間歇跑/測試跑的紀錄,可以先到跑步歷史幫紀錄補上標籤。';
    return;
  }
  canvas.style.display = '';
  if(emptyEl) emptyEl.remove();

  const easyByMonth = {}, speedByMonth = {}, allMonths = new Set();
  runs.forEach(r=>{
    const key = monthKey(new Date(r.date));
    allMonths.add(key);
    if(classifyRunCategory(r.tag)==='easy') easyByMonth[key] = (easyByMonth[key]||0) + r.distanceKm;
    else speedByMonth[key] = (speedByMonth[key]||0) + r.distanceKm;
  });
  let months = Array.from(allMonths).sort();
  if(chartRangeMode==='all') months = months.slice(-12); // 沒特別選範圍時,只看最近12個月避免太擠

  const easyKm = months.map(k=> +((easyByMonth[k]||0).toFixed(2)));
  const speedKm = months.map(k=> +((speedByMonth[k]||0).toFixed(2)));
  const totals = months.map((k,i)=> easyKm[i] + speedKm[i]);
  const isPercent = monthCompareMode==='percent';
  const pct = (v,i)=> totals[i]>0 ? +(v/totals[i]*100).toFixed(1) : 0;

  charts.monthCompare = new Chart(canvas, {
    type:'bar',
    data:{
      labels: months,
      datasets:[
        { label:'輕鬆跑', data: isPercent ? easyKm.map(pct) : easyKm, backgroundColor:'#2f5233', borderRadius:4, maxBarThickness:isPercent?40:28 },
        { label:'速度課', data: isPercent ? speedKm.map(pct) : speedKm, backgroundColor:'#e8a33d', borderRadius:4, maxBarThickness:isPercent?40:28 }
      ]
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{
        legend:{display:true, position:'top', labels:{boxWidth:12,font:{size:11}}},
        tooltip:{ callbacks:{ label: c=>{
          const km = (c.datasetIndex===0 ? easyKm : speedKm)[c.dataIndex];
          const p = totals[c.dataIndex]>0 ? (km/totals[c.dataIndex]*100).toFixed(0) : 0;
          return `${c.dataset.label}:${km} km(${p}%)`;
        } } }
      },
      scales:{
        y:{ stacked:isPercent, beginAtZero:true, max:isPercent?100:undefined, grid:{color:'#eceee9'}, ticks:{ callback: v=> isPercent ? v+'%' : v } },
        x:{ stacked:isPercent, grid:{display:false} }
      }
    }
  });
}
