  shoeSelect.innerHTML = '<option value="">全部跑鞋</option>' + SHOES.map(s=>`<option value="${s.id}">${s.name}</option>`).join('');
  if(SHOES.some(s=>s.id===keepShoe)) shoeSelect.value = keepShoe;
