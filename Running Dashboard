function getFilteredHistoryRuns(){
  const tag = document.getElementById('filterTag').value;
  const shoeId = document.getElementById('filterShoe').value;
  const minKm = parseFloat(document.getElementById('filterMinKm').value);
  const maxKm = parseFloat(document.getElementById('filterMaxKm').value);
  return RUNS.filter(r=>{
    if(tag && r.tag!==tag) return false;
    if(shoeId && r.shoeId!==shoeId) return false;
    if(!isNaN(minKm) && r.distanceKm<minKm) return false;
    if(!isNaN(maxKm) && r.distanceKm>maxKm) return false;
    return true;
  });
}

