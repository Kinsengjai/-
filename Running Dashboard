   訓練計畫頁面
   ========================================================= */
function formatIntervals(iv){
  if(!iv) return '';
  const per = iv.perUnit==='time' ? formatDuration(iv.perTimeSec) : `${iv.perDistanceM}m`;
  const pace = iv.paceSecPerKm ? ` @ ${formatPace(iv.paceSecPerKm)}` : '';
  return `${iv.sets} 組 x ${per}${pace}`;
}

// 總覽用:本週(週一~週日)的訓練計畫小卡,跟計畫頁面共用 formatIntervals
function renderWeekPlan(){
  const wrap = document.getElementById('weekPlanWrap');
  const today = new Date(); today.setHours(0,0,0,0);
  const monday = getWeekStartLabel(today);
  const todayKey = localISODate(today);
  const dayNames = ['一','二','三','四','五','六','日'];

  let html = '<div class="week-plan-grid">';
  for(let i=0; i<7; i++){
    const d = new Date(monday); d.setDate(d.getDate()+i);
    const key = localISODate(d);
    const plan = PLAN.find(p=>p.date===key);
    const madeUp = plan && plan.completedDate && plan.completedDate!==plan.date;
    const done = RUNS.some(r=>r.date===key) || (madeUp && RUNS.some(r=>r.date===plan.completedDate));
    const isToday = key===todayKey;

    let bodyHtml;
    if(plan){
      const distText = plan.distanceKm!=null ? `${plan.distanceKm} km` : '';
      const paceText = plan.expectedPaceSecPerKm ? ` @ ${formatPace(plan.expectedPaceSecPerKm)}` : '';
      const intervalText = plan.intervals ? formatIntervals(plan.intervals) : '';
      bodyHtml = `
        <div class="week-plan-tag">${plan.tag || '訓練'}</div>
        <div class="week-plan-detail">${distText}${paceText}</div>
        ${intervalText ? `<div class="week-plan-detail">${intervalText}</div>` : ''}
        ${madeUp ? `<div class="week-plan-detail" style="color:var(--amber);">補跑於 ${formatDate(plan.completedDate)}</div>` : ''}
      `;
    }else{
      bodyHtml = `<div class="week-plan-empty">未排定</div>`;
    }

    let statusBadge = '';
    if(done) statusBadge = '<span class="week-plan-status done">✓</span>';
    else if(madeUp) statusBadge = '<span class="week-plan-status" style="color:var(--amber);">↻</span>';
    else if(plan && key<todayKey) statusBadge = '<span class="week-plan-status missed">✕</span>';

    html += `
      <div class="week-plan-day ${isToday?'is-today':''}">
        <div class="week-plan-daylabel"><span>${dayNames[i]}</span>${statusBadge}</div>
        <div class="week-plan-date">${d.getMonth()+1}/${d.getDate()}</div>
        ${bodyHtml}
      </div>
    `;
  }
  html += '</div>';
  wrap.innerHTML = html;
}

function isPlanCompleted(p){
  const effectiveDate = p.completedDate || p.date;
  return RUNS.some(r=>r.date===effectiveDate);
}
function renderPlanStats(){
  const el = document.getElementById('planStats');
  const today = localISODate(new Date());
  const resolved = PLAN.filter(p=>p.date<=today); // 只算已經到期的計畫,還沒到的先不計入
  const completed = resolved.filter(isPlanCompleted);
  const thisMonth = monthKey(new Date());
  const monthResolved = resolved.filter(p=>monthKey(new Date(p.date))===thisMonth);
  const monthCompleted = monthResolved.filter(isPlanCompleted);

  const fmt = (c,t)=> t===0 ? '—' : `${c}/${t}<small>(${Math.round(c/t*100)}%)</small>`;
  el.innerHTML = `
    <div class="stat-card"><div class="stat-label">本月達成率</div><div class="stat-value">${fmt(monthCompleted.length, monthResolved.length)}</div></div>
    <div class="stat-card"><div class="stat-label">全部達成率</div><div class="stat-value">${fmt(completed.length, resolved.length)}</div></div>
  `;
}

let postponingPlanId = null;
function renderPlanPage(){
  renderPlanStats();
  const wrap = document.getElementById('planWrap');
  if(PLAN.length===0){
    wrap.innerHTML = '<div class="empty-state">還沒有排定任何訓練計畫,先在上面加入一筆吧。</div>';
    return;
  }
  const today = localISODate(new Date());
  const sorted = [...PLAN].sort((a,b)=> new Date(a.date)-new Date(b.date));
  const rows = sorted.map(p=>{
    const isMadeUp = p.completedDate && p.completedDate!==p.date;
    const effectiveDate = p.completedDate || p.date;
    const matched = RUNS.filter(r=>r.date===effectiveDate);
    const done = matched.length>0;
    const doneKm = matched.reduce((s,r)=>s+r.distanceKm,0);
    const madeUpNote = isMadeUp ? `・補跑於 ${formatDate(p.completedDate)}` : '';
    const isMissed = !done && !isMadeUp && p.date < today;
    let statusHtml;
    if(done) statusHtml = `<span style="color:var(--pine);font-weight:600;">✓ 已完成(實際 ${doneKm.toFixed(1)}km${madeUpNote})</span>`;
    else if(isMadeUp) statusHtml = `<span style="color:var(--amber);">已標記補跑於 ${formatDate(p.completedDate)},但那天還沒有對應紀錄</span>`;
    else if(isMissed) statusHtml = `<span style="color:var(--danger);">未完成</span>`;
    else statusHtml = `<span style="color:var(--ink-soft);">尚未到期</span>`;
    const tagCell = p.intervals
      ? `${p.tag || '—'}<div class="period-hint">${formatIntervals(p.intervals)}</div>`
      : (p.tag || '—');
    const distanceCell = (p.distanceKm!=null ? p.distanceKm+' km' : '—')
      + (p.expectedPaceSecPerKm ? `<div class="period-hint">@ ${formatPace(p.expectedPaceSecPerKm)}</div>` : '');

    const actionsHtml = postponingPlanId===p.id
      ? `
        <div style="display:flex;gap:4px;align-items:center;">
          <input type="date" id="postponeDateInput" value="${today}" style="border:1px solid var(--line);border-radius:6px;padding:4px 6px;font-size:12px;font-family:'IBM Plex Mono',monospace;background:var(--panel);color:var(--ink);">
          <button data-action="confirmPostpone" data-id="${p.id}" style="border:none;background:var(--pine);color:#fff;border-radius:6px;padding:4px 9px;font-size:12px;cursor:pointer;">確定</button>
          <button data-action="cancelPostpone" style="border:1px solid var(--line);background:var(--panel);border-radius:6px;padding:4px 9px;font-size:12px;cursor:pointer;color:var(--ink-soft);">取消</button>
        </div>
      `
      : `
        <button data-action="editPlan" data-id="${p.id}" style="border:1px solid var(--line);background:var(--panel);border-radius:7px;padding:4px 10px;font-size:12px;cursor:pointer;color:var(--ink-soft);margin-right:4px;">編輯</button>
        ${isMissed ? `<button data-action="postponePlan" data-id="${p.id}" style="border:1px solid var(--line);background:var(--panel);border-radius:7px;padding:4px 10px;font-size:12px;cursor:pointer;color:var(--amber);margin-right:4px;">延期</button>` : ''}
        <button data-action="deletePlan" data-id="${p.id}" style="border:1px solid var(--line);background:var(--panel);border-radius:7px;padding:4px 10px;font-size:12px;cursor:pointer;color:var(--ink-soft);">刪除</button>
      `;

    return `
      <tr>
        <td>${formatDate(p.date)}</td>
        <td class="mono">${distanceCell}</td>
        <td>${tagCell}</td>
        <td>${p.note || '—'}</td>
        <td>${statusHtml}</td>
        <td style="white-space:nowrap;">${actionsHtml}</td>
      </tr>
    `;
  }).join('');
  wrap.innerHTML = `
    <table>
      <thead><tr><th>日期</th><th class="mono">預計距離</th><th>類型</th><th>備註</th><th>狀態</th><th></th></tr></thead>
      <tbody>${rows}</tbody>
    </table>
  `;
}
document.getElementById('planWrap').addEventListener('click', (e)=>{
  const delBtn = e.target.closest('button[data-action="deletePlan"]');
  if(delBtn){
    PLAN = PLAN.filter(p=>p.id!==delBtn.dataset.id);
    savePlan(PLAN);
    if(editingPlanId===delBtn.dataset.id) exitPlanEditMode();
    renderPlanPage();
    return;
  }
  const postponeBtn = e.target.closest('button[data-action="postponePlan"]');
  if(postponeBtn){
    postponingPlanId = postponeBtn.dataset.id;
    renderPlanPage();
    return;
  }
  const cancelPostponeBtn = e.target.closest('button[data-action="cancelPostpone"]');
  if(cancelPostponeBtn){
    postponingPlanId = null;
    renderPlanPage();
    return;
  }
  const confirmPostponeBtn = e.target.closest('button[data-action="confirmPostpone"]');
  if(confirmPostponeBtn){
    const newDate = document.getElementById('postponeDateInput').value;
    if(newDate){
      const p = PLAN.find(x=>x.id===confirmPostponeBtn.dataset.id);
      if(p){
        p.date = newDate;
        p.completedDate = null; // 延期是改排定日期,不是標記補跑,清掉避免混淆
        savePlan(PLAN);
      }
    }
    postponingPlanId = null;
    renderPlanPage();
    return;
  }
  const editBtn = e.target.closest('button[data-action="editPlan"]');
  if(editBtn) enterPlanEditMode(editBtn.dataset.id);
});

