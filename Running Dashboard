  const keepTag = tagSelect.value;
  tagSelect.innerHTML = '<option value="">全部標籤</option>' + usedTags.map(t=>`<option value="${t}">${t}</option>`).join('');
  if(usedTags.includes(keepTag)) tagSelect.value = keepTag;

