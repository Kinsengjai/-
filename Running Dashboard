// 通用版:讓「手動輸入」與「詳情編輯」也能記錄間歇組別,選到節奏/間歇才顯示
function wireIntervalToggle(tagInputId, fieldsId, paceRowId, unitId, distFieldId, timeFieldId, onChange){
  function update(){
    const tag = document.getElementById(tagInputId).value;
    const show = tag.includes('節奏') || tag.includes('間歇');
    document.getElementById(fieldsId).style.display = show ? '' : 'none';
    document.getElementById(paceRowId).style.display = show ? '' : 'none';
  }
  document.getElementById(tagInputId).addEventListener('input', update);
  document.getElementById(unitId).addEventListener('change', (e)=>{
    const isTime = e.target.value==='time';
    document.getElementById(distFieldId).style.display = isTime ? 'none' : '';
    document.getElementById(timeFieldId).style.display = isTime ? '' : 'none';
    if(onChange) onChange();
  });
  return update;
}
